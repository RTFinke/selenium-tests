# Copy this file to .env for local assessment. Never put the real key here.
# GitHub Actions uses the OPENAI_API_KEY repository secret instead of .env.
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-4.1
OPENAI_PASS_SCORE_THRESHOLD=80
OPENAI_MAX_MINOR_LABELS_FOR_PASS=2
OPENAI_CONCURRENCY=2
OPENAI_DELAY_MS=750
OPENAI_TIMEOUT_MS=180000
OPENAI_MAX_RETRIES=3

# gallery = images only; review = AI judgment; comparison = explicit no-AI review
ANALYSIS_REPORT_MODE=review
ANALYSIS_OUTPUT_DIR=outputs

# Optional: point at one unpacked artifact root, several roots, or test folders.
# Without this, test_results_upper/lower/full and test_results are discovered.
# ANALYZE_SOURCE_DIR=test_results
